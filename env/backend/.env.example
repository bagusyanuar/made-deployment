APP_NAME=made-printing
APP_VERSION="1.0.0"

APP_ENV=production
APP_PORT=8000
APP_DEBUG=false
APP_CORS_ALLOWED_ORIGINS=https://pos.madeprinting.com,https://madeprinting.com,https://www.madeprinting.com

# Database Connection (Host matches service name in docker-compose)
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=YOUR_STRONG_DB_PASSWORD
DB_NAME=db_made_printing
DB_SSLMODE=disable

# JWT Authentication
JWT_ISSUER=made-printing-app
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY
JWT_EXPIRATION=60
JWT_SECRET_REFRESH=CHANGE_THIS_TO_ANOTHER_SECURE_RANDOM_SECRET_KEY
JWT_EXPIRATION_REFRESH=1440

# Logging
LOG_FILE=.logs/app.log
LOG_MAX_SIZE=10
LOG_MAX_BACKUPS=5
LOG_MAX_AGE=14
LOG_COMPRESS=true
LOG_LEVEL=info

CASBIN_MODEL_PATH=configs/rbac_model.conf

